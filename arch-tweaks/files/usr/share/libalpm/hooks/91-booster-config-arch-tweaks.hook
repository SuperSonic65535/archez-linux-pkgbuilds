[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = boot/initramfs-linux*.img
Target = boot/booster-linux*.img
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Configure initramfs (2/2)
When = PostTransaction
Exec = /usr/lib/arch-tweaks/system-scripts/booster-config
